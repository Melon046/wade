# ===========================================================================
# BATCHER — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. NEVER commit real keys.
# ===========================================================================

# --- Supabase --------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM providers ---------------------------------------------------------
# PRIMARY — Google AI Studio (free tier, no credit card required)
# Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key

# FALLBACK — Groq (free tier, much larger daily request budget)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key

# --- Model selection (optional — defaults are set in src/lib/models.ts) -----
# Model IDs are retired by providers over time. If you get a 404 "model not
# found", check the provider's model list and override here.
BATCHER_PRIMARY_MODEL=gemini-2.5-flash
BATCHER_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional guardrails ---------------------------------------------------
# Max assistant output tokens per turn (keeps a runaway reply from eating your
# free-tier quota). Defaults to 2048.
BATCHER_MAX_OUTPUT_TOKENS=2048

# Max tokens a single user may consume per day. 0 disables the check.
# Defaults to 0 (disabled) — turn it on before you share a public link.
BATCHER_DAILY_TOKEN_LIMIT=0
